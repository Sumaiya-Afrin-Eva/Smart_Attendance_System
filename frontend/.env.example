# Copy this file to ".env" (same folder) and fill in the values.

# OAuth "Web application" client ID from Google Cloud Console.
# Leave empty to use Dev login (type any @stud.kuet.ac.bd email, no Google needed).
VITE_GOOGLE_CLIENT_ID=

# Only needed when the backend runs on ANOTHER computer, e.g.
# VITE_API_URL=https://your-tunnel.trycloudflare.com/api
VITE_API_URL=
