# Copy this file to ".env" and change the values.

# SQLite file in the backend folder. For PostgreSQL later:
# DATABASE_URL=postgresql+psycopg2://user:password@localhost:5432/attendance
DATABASE_URL=sqlite:///./attendance.db

# Secret used to sign login tokens. Use a long random string.
JWT_SECRET=change-this-to-a-long-random-string
JWT_EXPIRE_MINUTES=720

# OAuth "Web application" client ID from Google Cloud Console.
# Must be the SAME value as VITE_GOOGLE_CLIENT_ID in frontend/.env
GOOGLE_CLIENT_ID=

# Only Google accounts on this domain can register as students.
STUDENT_EMAIL_DOMAIN=stud.kuet.ac.bd

# Dev login lets you sign in as a student email WITHOUT Google (for testing).
# Set to false before the final demo.
DEV_LOGIN_ENABLED=true

# Where the React app runs (for CORS)
FRONTEND_ORIGIN=http://localhost:5173
